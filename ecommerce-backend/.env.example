# Local development only. Generate separate values with:
#   openssl rand -hex 32
# Do not use these placeholders or local settings in a production deployment.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce
JWT_SECRET=replace-with-a-random-32-byte-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-32-byte-secret
JWT_REFRESH_EXPIRES_IN=7d
NODE_ENV=development
